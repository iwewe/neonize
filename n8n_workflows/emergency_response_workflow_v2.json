    {
      "parameters": {
        "jsCode": "// Log bot status change\nconst item = $input.all()[0].json;\nconst data = item.data || {};\nconst timestamp = item.timestamp || new Date().toISOString();\n\nconsole.log('Bot Status Changed:', {\n  event: item.event_type,\n  session: data.session,\n  timestamp: timestamp\n});\n\nreturn {\n  json: {\n    status: 'logged',\n    event_type: item.event_type,\n    timestamp: timestamp\n  }\n};"
      },
      "id": "log-bot-status",
      "name": "Log Bot Status",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        400
      ]
    },
    {
      "parameters": {
        "jsCode": "// Generate auto-reply for emergency report\nconst item = $input.all()[0].json;\n\nconst reportId = `RPT-${Date.now()}`;\nconst disasterEmoji = {\n  'flood': '\ud83c\udf0a',\n  'earthquake': '\ud83c\udfda\ufe0f',\n  'fire': '\ud83d\udd25',\n  'landslide': '\u26f0\ufe0f',\n  'tsunami': '\ud83c\udf0a',\n  'other': '\u26a0\ufe0f'\n};\n\nconst emoji = disasterEmoji[item.disaster_type] || '\u26a0\ufe0f';\nconst severityStars = '\u2b50'.repeat(item.severity);\n\nconst reply = `${emoji} *LAPORAN DITERIMA*\\n\\n` +\n  `ID Laporan: ${reportId}\\n` +\n  `Jenis: ${item.disaster_type.toUpperCase()}\\n` +\n  `Tingkat: ${severityStars} (${item.severity}/5)\\n` +\n  `Waktu: ${new Date(item.timestamp).toLocaleString('id-ID')}\\n\\n` +\n  `\u2705 Tim emergency response telah menerima laporan Anda.\\n` +\n  `\ud83d\udcde Kami akan segera menghubungi untuk verifikasi.\\n\\n` +\n  `Tetap tenang dan ikuti instruksi petugas!`;\n\nreturn {\n  json: {\n    report_id: reportId,\n    sender: item.sender,\n    sender_name: item.sender_name,\n    chat: item.chat,\n    reply_message: reply,\n    disaster_type: item.disaster_type,\n    severity: item.severity\n  }\n};"
      },
