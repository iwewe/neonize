      "id": "switch-event-type",
      "name": "Switch Event Type",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Extract message data\nconst item = $input.all()[0].json.body || $input.all()[0].json;\nconst data = item.data || {};\n\n// Extract text and metadata\nconst text = data.text || '';\nconst sender = data.sender_name || 'Unknown';\nconst chat = data.chat || '';\nconst isGroup = data.is_group || false;\nconst timestamp = item.timestamp || new Date().toISOString();\n\n// Check for emergency keywords\nconst emergencyKeywords = [\n  'banjir', 'gempa', 'kebakaran', 'longsor', 'tsunami',\n  'darurat', 'emergency', 'tolong', 'bahaya'\n];\n\nconst textLower = text.toLowerCase();\nconst isEmergency = emergencyKeywords.some(keyword => textLower.includes(keyword));\n\n// Estimate severity based on keywords\nlet severity = 1;\nif (textLower.includes('parah') || textLower.includes('besar')) severity = 5;\nelse if (textLower.includes('sangat') || textLower.includes('banyak')) severity = 4;\nelse if (textLower.includes('lumayan') || textLower.includes('sedang')) severity = 3;\nelse if (textLower.includes('kecil') || textLower.includes('ringan')) severity = 2;\n\n// Detect disaster type\nlet disasterType = 'other';\nif (textLower.includes('banjir')) disasterType = 'flood';\nelse if (textLower.includes('gempa')) disasterType = 'earthquake';\nelse if (textLower.includes('kebakaran')) disasterType = 'fire';\nelse if (textLower.includes('longsor')) disasterType = 'landslide';\nelse if (textLower.includes('tsunami')) disasterType = 'tsunami';\n\nreturn {\n  json: {\n    message_id: data.message_id,\n    sender: data.sender,\n    sender_name: sender,\n    chat: chat,\n    is_group: isGroup,\n    text: text,\n    is_emergency: isEmergency,\n    disaster_type: disasterType,\n    severity: severity,\n    timestamp: timestamp,\n    processed_at: new Date().toISOString()\n  }\n};"
      },
      "id": "process-message",
      "name": "Process Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        200
      ]
    },
    {
      "parameters": {
